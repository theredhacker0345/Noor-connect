<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep user data small enough for the 25 MB cloud quota:
             localStorage (all app state + in-app auto-backup snapshot),
             Capacitor Preferences. Exclude large
             re-downloadable caches. -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="root" path="app_webview/" />
        <include domain="root" path="cache/" />
        <exclude domain="root" path="app_webview/BlobStorage/" />
        <exclude domain="root" path="app_webview/Default/IndexedDB/" />
        <exclude domain="root" path="app_webview/Default/Service Worker/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/File System/" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfers are not limited to 25 MB, so carry
             everything including downloaded audio/PDFs. -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <include domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
