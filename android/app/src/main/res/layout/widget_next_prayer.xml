<?xml version="1.0" encoding="utf-8"?>
<!--
  Next Prayer Widget (4×2) — 2026 Premium Redesign
  ─────────────────────────────────────────────────
  LEFT  : نور brand glyph · Hijri chip · "NEXT PRAYER" label
          · Prayer name in large bold · location pill
  RIGHT : 270° progress ring wrapping live TextClock
          · Prayer time below clock · "in Xh Ym" countdown chip
  BOTTOM: stale badge if data is old
  ─────────────────────────────────────────────────
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_shape"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:layoutDirection="locale"
    android:textDirection="locale">

    <!-- ══════ LEFT SECTION ══════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="start|center_vertical">

        <!-- Brand + Hijri chip row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Arabic brand mark "نور" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/amiri_quran"
                android:text="نور"
                android:textColor="@color/widget_accent_emerald"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Vertical divider dot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="·"
                android:textColor="@color/widget_accent_gold"
                android:textSize="16sp"
                android:alpha="0.6" />

            <!-- Hijri date chip -->
            <TextView
                android:id="@+id/widget_hijri_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip_shape"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="@string/widget_hijri_default"
                android:textColor="@color/widget_accent_gold"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- "NEXT PRAYER" section label -->
        <TextView
            android:id="@+id/widget_section_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.18"
            android:text="@string/widget_next_prayer_section"
            android:textAllCaps="true"
            android:textColor="@color/widget_accent_gold"
            android:textSize="8sp"
            android:textStyle="bold"
            android:alpha="0.7" />

        <!-- Prayer name — the hero element -->
        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/prayer_maghrib"
            android:textColor="@color/widget_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02" />

        <!-- Stale data badge -->
        <TextView
            android:id="@+id/widget_stale_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_stale_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_stale_badge_text"
            android:textColor="@android:color/white"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Location pill row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_chip_shape"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Location pin icon (simple circle) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="📍"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:text="@string/widget_location_default"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ══════ RIGHT SECTION — Progress Ring ══════ -->
    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="center_vertical">

        <!-- Ring track (background arc) -->
        <ImageView
            android:id="@+id/widget_ring_track"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_progress_ring_bg" />

        <!-- Ring fill (progress driven by setImageLevel) -->
        <ImageView
            android:id="@+id/widget_ring_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:src="@drawable/widget_progress_ring_fg" />

        <!-- Inner content — clock + prayer time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Live system clock (ticks every second, zero battery) -->
            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:textColor="@color/widget_accent_gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Prayer target time -->
            <TextView
                android:id="@+id/widget_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/widget_time_default"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Countdown chip — bottom right of ring -->
        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-2dp"
            android:background="@drawable/widget_chip_emerald"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_countdown_default"
            android:textColor="@color/widget_accent_emerald"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- ══════ Empty state (hidden by default, shown over root) ══════ -->
    <LinearLayout
        android:id="@+id/layout_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ornament_corner"
            android:alpha="0.5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_empty_subtitle"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/widget_empty_message"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/empty_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/widget_chip_emerald"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/widget_empty_action"
            android:textColor="@color/widget_accent_emerald"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
